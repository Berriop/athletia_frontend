# Navegador local. CHROME_PATH es opcional si Chrome se detecta automáticamente.
HEADLESS=false
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
STAGEHAND_LOG_LEVEL=info

# Ollama local: no necesita una clave externa.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
OLLAMA_MODEL=qwen2.5:7b

# Opcional: URL de un frontend de Athletia ya desplegado. Si se define, no se levanta la pila local.
# E2E_BASE_URL=http://localhost:5174
# E2E_API_URL=http://localhost:4001/api/v1
